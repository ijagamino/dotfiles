[global]
font = "DepartureMono Nerd Font Propo 14"
padding = 16
horizontal_padding = 16
frame_color = "#d4be98"
frame_width = 2
separator_color = frame
highlight = "#d4be98"
offset = (48, 96)

[urgency_low]
background = "#1d2021"
foreground = "#d4be98"

[urgency_normal]
background = "#1d2021"
foreground = "#d4be98"

[urgency_critical]
background = "#1d2021"
foreground = "#d4be98"
frame_color = "#e78a4e"
